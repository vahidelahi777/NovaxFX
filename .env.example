# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains live credentials.

TWELVEDATA_API_KEY=your_twelvedata_key_here
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: comma-separated Telegram user IDs with admin rights
TELEGRAM_ADMIN_IDS=

# PostgreSQL — user registry for the product bot (DZ2)
# Use these credentials in both the postgres service and DATABASE_URL below.
POSTGRES_USER=novax
POSTGRES_PASSWORD=changeme
POSTGRES_DB=novax
DATABASE_URL=postgresql://novax:changeme@postgres:5432/novax
