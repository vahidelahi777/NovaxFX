# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains live credentials.

TWELVEDATA_API_KEY=your_twelvedata_key_here
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: comma-separated Telegram user IDs with admin rights
TELEGRAM_ADMIN_IDS=

# PostgreSQL — user registry for the product bot (DZ2)
# Use these credentials in both the postgres service and DATABASE_URL below.
POSTGRES_USER=novax
POSTGRES_PASSWORD=changeme
POSTGRES_DB=novax
DATABASE_URL=postgresql://novax:changeme@postgres:5432/novax

# Admin panel (H1) — run with: python scripts/run_admin.py
# Generate ADMIN_PASSWORD_HASH:
#   python -c "from novax.admin.auth import hash_password; print(hash_password('your-password'))"
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=change-me-to-a-long-random-string
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8001

# Channel aggregator (opt-in — start with: docker compose --profile aggregator up -d channel-aggregator)
# Requires a Telegram user account (not a bot) registered via the Telegram API.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=
# ANTHROPIC_API_KEY=
